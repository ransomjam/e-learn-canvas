# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Option A (recommended for prod): single connection string, e.g. from Neon
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/elearn_canvas?sslmode=require
# Option B (local dev): discrete settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearn_canvas
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@elearn-canvas.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Cloudflare R2 — images, PDFs, documents (S3-compatible, zero egress fees)
# Create a bucket + API token at https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=cradema
# Public bucket URL: either the r2.dev development URL or a custom domain
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Bunny Stream — course videos (transcoding + adaptive HLS + CDN)
# Create a Video Library at https://dash.bunny.net → Stream
BUNNY_LIBRARY_ID=12345
BUNNY_API_KEY=your_bunny_stream_library_api_key
BUNNY_CDN_HOST=vz-xxxxxxxx-xxx.b-cdn.net

# Cloudinary (LEGACY — only needed while old assets still live there)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AI Course Studio ─────────────────────────────────────────────
# Gemini powers content understanding + generation (recommended).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_LONG=gemini-2.5-pro
# AI_PROVIDER=gemini            # gemini | deepseek
# DEEPSEEK_API_KEY=             # text-only fallback provider
# AI_JOB_CONCURRENCY=2
# Whiteboard narration voice (optional overrides)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
